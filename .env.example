PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/johnny_gifts

# Public address of this backend. Used for referral links (/go/...) and uploaded images.
PUBLIC_URL=http://localhost:5000

# Website and dashboard addresses (allowed to call the API)
SITE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173

# Set to true when the backend runs behind a hosting proxy (most hosts), so request limits count each visitor.
TRUST_PROXY=false

# Dashboard login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

JWT_SECRET=put-a-long-random-string-here
# Must match REVALIDATE_SECRET in website/.env.local
REVALIDATE_SECRET=put-another-random-string-here

# Optional Amazon Associates tag added to Amazon referral links
AMAZON_TAG=

# Sending newsletter emails
# With RESEND_API_KEY set, emails go out through Resend (https://resend.com/api-keys).
# Without it, they go through the SMTP settings below. For local testing, run Mailpit and use 127.0.0.1 / 1025.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend
EMAIL_FROM="Your Brand <news@yourdomain.com>"
RESEND_REQUESTS_PER_SECOND=2

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_RATE_PER_SECOND=5
MAILPIT_URL=http://localhost:8025
